filters:
  and:
    - file.inFolder("tools")
    - file.ext == "md"
properties:
  file.name:
    displayName: Tool
  type:
    displayName: Type
  summary:
    displayName: Summary
  updated_at:
    displayName: Updated
views:
  - type: table
    name: "Tools"
    order:
      - file.name
      - type
      - summary
      - updated_at
