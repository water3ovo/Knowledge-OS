filters:
  and:
    - file.inFolder("knowledge")
    - file.ext == "md"
properties:
  file.name:
    displayName: Knowledge
  domain:
    displayName: Domain
  type:
    displayName: Type
  summary:
    displayName: Summary
  updated_at:
    displayName: Updated
views:
  - type: table
    name: "Recently Updated"
    limit: 12
    order:
      - file.name
      - domain
      - type
      - updated_at
  - type: table
    name: "By Domain"
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - type
      - summary
