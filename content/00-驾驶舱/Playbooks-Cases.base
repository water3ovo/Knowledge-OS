filters:
  or:
    - and:
        - file.inFolder("playbooks")
        - file.ext == "md"
    - and:
        - file.inFolder("cases")
        - file.ext == "md"
properties:
  file.name:
    displayName: Item
  type:
    displayName: Type
  summary:
    displayName: Summary
  updated_at:
    displayName: Updated
views:
  - type: table
    name: "Playbooks"
    filters:
      and:
        - file.inFolder("playbooks")
    order:
      - file.name
      - type
      - summary
  - type: table
    name: "Cases"
    filters:
      and:
        - file.inFolder("cases")
    order:
      - file.name
      - type
      - summary
