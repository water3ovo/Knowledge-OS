filters:
  and:
    - file.inFolder("01-知识库")
    - file.ext == "md"
properties:
  file.name:
    displayName: 知识
  domain:
    displayName: 领域
  type:
    displayName: 类型
  summary:
    displayName: 一句话
  updated_at:
    displayName: 最近更新
views:
  - type: table
    name: 最近沉淀
    order:
      - file.name
      - domain
      - updated_at
    limit: 12
  - type: table
    name: 按领域浏览
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - summary
